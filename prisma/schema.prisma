generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
// Kenya Digital Infrastructure Database
// Data Centre 254 — dc254.ke
// ────────────────────────────────────────────────────────────────

// Core entity: A single data centre facility
model Facility {
  id              String   @id @default(cuid())
  name            String                       // e.g. "NBOX1"
  slug            String   @unique              // e.g. "nbox1"
  description     String?                      // Brief description
  status          String   @default("Operational") // Operational, Under Construction, Planned, Announced

  // Location
  address         String?
  city            String   @default("Nairobi")
  region          String   @default("Nairobi County")
  coordinates     String?                      // "-1.2855,36.8245"

  // Capacity
  itLoadMw        Float?                       // IT load in megawatts
  totalCapacityMw Float?                       // Total facility capacity MW
  rackCount       Int?                         // Total racks
  occupiedRacks   Int?                         // Occupied racks
  floorSpaceSqM   Int?                         // Floor space in square metres

  // Classification
  tierRating      String?                      // Tier I, II, III, IV, or "Designed for Tier III"
  facilityType    String?                      // Colocation, Hyperscale, Edge, Telco, Enterprise
  aiReady         Boolean  @default(false)      // High-density racks for AI/GPU workloads

  // Key dates
  openedDate      String?                      // YYYY or YYYY-MM
  expansionDate   String?                      // Expected expansion completion

  // Details
  coolingType     String?                      // Air, Liquid, Direct-to-Chip, Immersion, Hybrid
  powerSource     String?                      // Grid, Geothermal, Solar, Hybrid
  renewableClaim  String?                      // Operator's renewable energy claim
  notable         String?                      // Key notable fact

  // Metadata
  lastVerified    String?                      // Date this data was last verified
  dataSource      String?                      // Where this data came from
  dataConfidence  String   @default("Medium")   // High, Medium, Low

  // Relations
  operatorId      String
  operator        Operator @relation(fields: [operatorId], references: [id])

  connectivityFacility ConnectivityProviderFacility[]
  certifications    FacilityCertification[]
  
  // Phase 1 relations
  pricingData     PricingData[]
  outageReports   OutageReport[]
  energyMetrics   EnergyMetric[]
  tenants         Tenant[]
  jobPostings     JobPosting[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([city])
  @@index([status])
  @@index([operatorId])
}

// Companies that own or operate data centres
model Operator {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  hqCountry   String   @default("Kenya")
 parentCompany String?   // e.g. "Liquid Intelligent Technologies" for "Africa Data Centres"
 website     String?
  type        String?    // DC Operator, Telco, Cloud Provider, REIT

  facilities   Facility[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Connectivity providers available at a facility
model ConnectivityProvider {
  id          String     @id @default(cuid())
  name        String
  type        String?    // Subsea Cable, Fibre Operator, IXP, Cloud On-Ramp, CDN
  description String?

  facilities   ConnectivityProviderFacility[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Many-to-many: facilities <-> connectivity providers
model ConnectivityProviderFacility {
  facilityId       String
  providerId       String
  
  facility         Facility             @relation(fields: [facilityId], references: [id])
  provider         ConnectivityProvider @relation(fields: [providerId], references: [id])

  @@id([facilityId, providerId])
}

// Industry certifications held by a facility
model Certification {
  id          String     @id @default(cuid())
  name        String                      // e.g. "ISO 27001", "Tier III Design", "SOC 2"
  type        String?                    // Security, Design, Environmental, Operational
  description String?

  facilities   FacilityCertification[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Many-to-many: facilities <-> certifications
model FacilityCertification {
  facilityId      String
  certificationId String

  facility        Facility     @relation(fields: [facilityId], references: [id])
  certification    Certification @relation(fields: [certificationId], references: [id])

  @@id([facilityId, certificationId])
}

// ────────────────────────────────────────────────────────────────
// Articles & Verification System
// ────────────────────────────────────────────────────────────────

model Article {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  tlDr            String?                         // One-sentence TL;DR
  description     String?                         // Short description for meta/listing
  cluster         String                           // Beginner, Kenya, Internet, Energy, Careers
  status          String   @default("Draft")       // Draft, InReview, Published
  content         String                           // Markdown body
  readingTimeMin  Int?                             // Estimated reading time in minutes

  // Verification
  lastVerified    String?
  dataSource      String?

  // SEO
  metaTitle       String?
  metaDescription String?

  // Ordering within cluster
  sortOrder       Int      @default(0)

  // Foundational articles — the 12 that launch DC254 Brief
  isFoundational  Boolean  @default(false)
  foundationalOrder Int     @default(0)

  // Relations
  claims          ArticleClaim[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cluster])
  @@index([status])
  @@index([cluster, sortOrder])
}

// ────────────────────────────────────────────────────────────────
// Newsletter Subscribers
// ────────────────────────────────────────────────────────────────

model Subscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  status        String   @default("Active")  // Active, Unsubscribed
  source        String?                          // Where they subscribed (homepage, article, etc.)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model ArticleClaim {
  id              String   @id @default(cuid())
  claim           String                           // The factual statement
  source          String?                          // URL or document reference
  sourceTitle     String?                          // Human-readable source name
  verifiedDate    String?                          // YYYY-MM or YYYY-MM-DD
  confidence      String   @default("Medium")     // High, Medium, Low, Unverified
  notes           String?                          // Additional context

  articleId       String
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────
// Phase 1 Enhancement Models - Intelligence Platform
// ────────────────────────────────────────────────────────────────

// Pricing data for facilities (colocation pricing intelligence)
model PricingData {
  id              String   @id @default(cuid())
  facilityId      String
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  
  // Pricing type
  pricingType     String                           // Colocation, Cloud, Managed Services
  serviceLevel    String?                          // Standard, Premium, Enterprise
  
  // Power-based pricing
  pricePerRackMw  Float?                           // Price per rack per month (USD)
  rackDensityKw   Float?                           // kW per rack
  minimumCommitmentKw Float?                       // Minimum power commitment
  
  // Space-based pricing
  pricePerSqM     Float?                           // Price per square meter per month (USD)
  pricePerCabinet Float?                           // Price per cabinet per month (USD)
  
  // Cross-connect pricing
  crossConnectPrice Float?                         // Price per cross-connect (USD/month)
  
  // Currency and validity
  currency        String   @default("USD")
  validFrom       String                           // YYYY-MM
  validUntil      String?                          // YYYY-MM
  isPublic        Boolean  @default(false)         // Is this publicly available pricing?
  
  // Data quality
  dataSource      String?                          // Where this pricing came from
  dataConfidence  String   @default("Medium")     // High, Medium, Low
  
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([facilityId])
  @@index([pricingType])
}

// Outage and incident tracking
model OutageReport {
  id              String   @id @default(cuid())
  facilityId      String?
  facility        Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  
  // Outage details
  outageType      String                           // Planned, Unplanned, Maintenance
  severity        String   @default("Medium")     // Critical, High, Medium, Low
  status          String   @default("Investigating") // Investigating, Identified, Monitoring, Resolved
  
  // Timing
  startedAt       String                           // ISO 8601 timestamp
  resolvedAt      String?                          // ISO 8601 timestamp
  durationMinutes Int?                             // Total duration if resolved
  
  // Impact
  affectedServices String?                        // What services were affected
  impactDescription String?                        // Description of impact
  customersAffected Int?                           // Estimated number of customers affected
  
  // Root cause and resolution
  rootCause       String?
  resolution      String?
  
  // Reporting
  reportedBy      String?                          // Who reported this
  isVerified      Boolean  @default(false)
  verificationSource String?
  
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([facilityId])
  @@index([status])
  @@index([severity])
  @@index([startedAt])
}

// Energy metrics and sustainability data
model EnergyMetric {
  id              String   @id @default(cuid())
  facilityId      String
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  
  // Measurement period
  measurementDate String                           // YYYY-MM
  reportingPeriod String?                          // Monthly, Quarterly, Annual
  
  // Power usage
  totalPowerMwh   Float?                           // Total power consumed (MWh)
  itPowerMwh      Float?                           // IT equipment power (MWh)
  coolingPowerMwh Float?                           // Cooling system power (MWh)
  
  // Efficiency metrics
  pue             Float?                           // Power Usage Effectiveness
  wue             Float?                           // Water Usage Effectiveness (L/kWh)
  cue             Float?                           // Carbon Usage Effectiveness
  
  // Renewable energy
  renewablePercentage Float?                       // % of power from renewable sources
  renewableSource String?                          // Solar, Wind, Geothermal, Hydro, Mix
  onSiteGenerationMwh Float?                       // On-site renewable generation (MWh)
  
  // Carbon footprint
  carbonTonnesCO2 Float?                           // Total CO2 emissions (tonnes)
  carbonOffset    Float?                           // Carbon offsets purchased (tonnes)
  
  // Data quality
  isAudited       Boolean  @default(false)
  auditStandard   String?                          // ISO 50001, etc.
  dataSource      String?
  dataConfidence  String   @default("Medium")
  
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([facilityId])
  @@index([measurementDate])
  @@index([pue])
}

// Tenant/customer information (aggregate, non-sensitive)
model Tenant {
  id              String   @id @default(cuid())
  facilityId      String
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  
  // Tenant info (public/aggregate only)
  tenantName      String?                          // Company name if public
  tenantType      String                           // Enterprise, Hyperscaler, Government, Financial, Telco, Cloud
  industry        String?                          // Industry sector
  
  // Presence details
  presenceType    String                           // Colocation, Cloud Region, Edge Node, Interconnection
  rackCount       Int?                             // Number of racks occupied
  powerCommitmentKw Float?                         // Committed power (kW)
  floorSpaceSqM   Int?                             // Floor space occupied (sqm)
  
  // Timeline
  moveInDate      String?                          // YYYY-MM
  contractLengthMonths Int?                        // Contract length in months
  expansionPlanned Boolean @default(false)
  
  // Strategic importance
  isAnchorTenant  Boolean  @default(false)
  isHyperscaler   Boolean  @default(false)
  
  // Data quality
  isPublic        Boolean  @default(false)        // Is this publicly confirmed?
  dataSource      String?
  dataConfidence  String   @default("Medium")
  
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([facilityId])
  @@index([tenantType])
  @@index([isHyperscaler])
}

// Job postings for the careers board
model JobPosting {
  id              String   @id @default(cuid())
  
  // Job details
  title           String
  slug            String   @unique
  company         String
  companyId       String?                          // Link to Operator if applicable
  
  location        String
  locationType    String   @default("On-site")     // On-site, Hybrid, Remote
  facilityId      String?                          // Specific facility if on-site
  facility        Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  
  // Role details
  jobType         String   @default("Full-time")   // Full-time, Part-time, Contract, Internship
  experienceLevel String   @default("Mid-level")   // Entry, Mid, Senior, Executive
  department      String?                          // Engineering, Operations, Sales, etc.
  
  salaryMin       Int?                             // Minimum salary (USD/year)
  salaryMax       Int?                             // Maximum salary (USD/year)
  salaryCurrency  String   @default("USD")
  salaryPeriod    String   @default("yearly")      // yearly, monthly, hourly
  
  description     String                           // Full job description (markdown)
  requirements    String?                          // Requirements list (markdown)
  benefits        String?                          // Benefits list (markdown)
  
  // Application
  applicationUrl  String?
  applicationEmail String?
  applicationDeadline String?                      // YYYY-MM-DD
  
  // Status
  status          String   @default("Active")      // Active, Closed, On Hold
  isFeatured      Boolean  @default(false)
  
  // Metadata
  postedDate      String                           // YYYY-MM-DD
  expirationDate  String?                          // YYYY-MM-DD
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([status])
  @@index([jobType])
  @@index([experienceLevel])
  @@index([postedDate])
  @@index([facilityId])
}

// Premium report metadata
model Report {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  subtitle        String?
  
  // Content
  executiveSummary String?                        // Free preview
  fullContent     String?                        // Full report (markdown/pdf path)
  pageCount       Int?
  
  // Classification
  reportType      String   @default("Market Research") // Market Research, Technical Guide, Regulatory Update
  topic           String?                          // Primary topic
  regions         String?                          // Covered regions (comma-separated)
  
  // Pricing & Access
  priceUsd        Float?                           // Price in USD
  isFree          Boolean  @default(false)
  accessLevel     String   @default("Premium")     // Free, Newsletter, Premium, Enterprise
  
  // Publication
  publishedDate   String                           // YYYY-MM-DD
  updatedDate     String?                          // YYYY-MM-DD
  version         String   @default("1.0")
  
  // Authors
  authors         String?                          // Comma-separated author names
  sponsor         String?                          // If sponsored
  
  // Metrics
  downloadCount   Int      @default(0)
  viewCount       Int      @default(0)
  
  // Status
  status          String   @default("Draft")       // Draft, Published, Archived
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([status])
  @@index([reportType])
  @@index([publishedDate])
}

// User accounts for premium access (future authentication)
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?                          // Null if OAuth only
  
  // Profile
  name            String?
  company         String?
  jobTitle        String?
  country         String?
  
  // Subscription
  subscriptionTier String  @default("Free")        // Free, Newsletter, Premium, Enterprise
  subscriptionStart String?                        // ISO date
  subscriptionEnd   String?                        // ISO date
  
  // Permissions
  isAdmin         Boolean  @default(false)
  isVerified      Boolean  @default(false)        // Email verified
  
  // Activity
  lastLoginAt     String?                          // ISO timestamp
  loginCount      Int      @default(0)
  
  // Relations
  apiTokens       ApiToken[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([email])
  @@index([subscriptionTier])
}

// API access tokens for enterprise API users
model ApiToken {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String                           // Token name/description
  tokenHash       String                           // Hashed token value
  tokenPrefix     String                           // First few chars for identification
  
  // Permissions
  scope           String   @default("read")        // read, write, admin
  rateLimitPerMinute Int @default(60)
  
  // Usage tracking
  lastUsedAt      String?                          // ISO timestamp
  requestCount    Int      @default(0)
  
  // Lifecycle
  expiresAt       String?                          // ISO timestamp (null = never)
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([isActive])
}
