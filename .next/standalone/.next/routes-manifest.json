      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/beginners",
      "destination": "/data-centres",
      "statusCode": 308,
      "regex": "^(?!/_next)/beginners(?:/)?$"
