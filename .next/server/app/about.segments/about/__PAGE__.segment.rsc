0:{"buildId":"4Jxe1ZgOM2v5Q8OFrWXQy","rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen flex flex-col","children":[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":["$","div",null,{"className":"relative","children":[["$","div",null,{"className":"absolute inset-0 grid-bg opacity-30","aria-hidden":"true"}],["$","div",null,{"className":"absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_10%,oklch(0.78_0.14_195/3%),transparent_70%)]","aria-hidden":"true"}],["$","div",null,{"className":"relative z-10 mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-24 sm:py-32","children":[["$","div",null,{"className":"mb-16","children":[["$","span",null,{"className":"inline-block font-mono text-xs sm:text-sm tracking-widest text-cyan mb-4 uppercase","children":"About"}],["$","h1",null,{"className":"text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground leading-tight mb-6","children":"Why Data Centre 254 Exists"}],["$","p",null,{"className":"text-lg text-muted-foreground leading-relaxed","children":"There is no single place where a Kenyan can go to understand the physical infrastructure that makes their digital life possible. Data Centre 254 exists to fill that gap."}]]}],["$","section",null,{"className":"mb-16","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-semibold text-foreground mb-4","children":"The Problem We Are Solving"}],["$","div",null,{"className":"space-y-4 text-muted-foreground leading-relaxed","children":[["$","p",null,{"children":"When you send an M-Pesa payment, stream a video on YouTube, or store a file on Google Drive, your data travels through a physical chain of infrastructure: submarine cables landing in Mombasa, fibre optic networks crossing the country, internet exchange points in Nairobi, and data centres humming with servers, cooling systems, and backup generators."}],["$","p",null,{"children":"This infrastructure is real, it is being built at staggering speed in Kenya, and it matters to everyone who uses the internet. Yet almost nobody outside the industry understands how it works, where it is, who owns it, or why it matters. The information that does exist is scattered across investor presentations, technical whitepapers, news articles behind paywalls, and industry conference talks that never reach a public audience."}],["$","p",null,{"children":"Data Centre 254 was built to be the antidote to that fragmentation: a single, free, independent platform where anyone can learn about Kenya's digital infrastructure in plain language."}]]}]]}],["$","section",null,{"className":"mb-16","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-semibold text-foreground mb-4","children":"Who Is Behind This"}],["$","div",null,{"className":"space-y-4 text-muted-foreground leading-relaxed","children":[["$","p",null,{"children":["Data Centre 254 was founded and is operated by ",["$","strong",null,{"className":"text-foreground","children":"Kevin Jonathan Otieno"}],", a Kenyan founder, writer and content creator with a background in communications, digital media, digital marketing and technology. He is self-taught in areas of AI, cloud computing and digital infrastructure."]}],["$","p",null,{"children":"The platform is not backed by any data centre operator, telecom company, or government agency. It is an independent project built out of a conviction that public understanding of digital infrastructure is essential for a healthy digital economy."}],["$","p",null,{"children":"This platform does not claim special insider expertise or industry credentials. The strength behind DC254 is translation: taking complex technology and infrastructure topics and making them clear and accessible for the Kenyan public, businesses, students and aspiring professionals. Every topic is researched, verified, and explained with transparency about where information comes from and how confident we are in each claim."}]]}],"$L3"]}],"$L4","$L5","$L6","$L7"]}]]}]}],"$L8"]}],["$L9","$La","$Lb"],"$Lc"]}],"loading":null,"isPartial":false}
