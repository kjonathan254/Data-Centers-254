# Google Analytics (optional — leave empty to disable)
NEXT_PUBLIC_GA_ID=""

# PostHog (optional — product analytics; loads only after consent-banner accept).
# Project API key (phc_...) from posthog.com -> Project settings -> Project API key.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Canonical site URL (used for sitemap, OG tags, RSS). Change when the custom domain is live.
NEXT_PUBLIC_SITE_URL="https://data-centers-254.vercel.app"

# Resend — Contact form emails + Newsletter subscribers
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="onboarding@resend.dev"  # optional, only needed for contact form sends

# Resend Segment (formerly Audience) — optional.
# Create one under https://resend.com/dashboard → Contacts → Segments, then paste its ID
# so newsletter subscribers are grouped together.
# RESEND_SEGMENT_ID=""

# Webhook signing secret (REQUIRED in production) — /api/resend/webhook
# refuses every unverified call without it. Create a webhook under
# https://resend.com/dashboard → Webhooks for events email.bounced +
# email.complained, then copy the signing secret (whsec_...) here.
# RESEND_WEBHOOK_SECRET="whsec_..."

# Newsletter double opt-in signing secret (REQUIRED in production, >=32
# random chars) — signs the verify/unsubscribe links in confirmation emails.
# Generate with: openssl rand -hex 32
# SUBSCRIBE_SECRET=""

# Optional bearer token that locks /api/chat/health FULL diagnostics behind an
# auth check. It does NOT gate /api/health (the deployment health route is
# open by design for load-balancer probes — see security audit C1, 2026-10-20).
# Leave empty for open health checks (default).
# HEALTH_TOKEN=""

# Optional allow-list of hostnames (comma-separated) that /api/sponsor/click
# accepts as outbound sponsor targets. With nothing set the endpoint is
# same-origin only, which is the recommended default.
# SPONSOR_ALLOWED_HOSTS="example.com,partner.co.ke"

# Groq — Jibu's LLM brain + HD voice (free tier). Optional: without a key the
# chatbot runs fully deterministic and voice falls back to the device.
# Get a key at https://console.groq.com/keys (never commit the real key!)
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"       # optional override
# CHAT_TTS_VOICE="Celeste-PlayAI"            # optional override

# Upstash Redis (optional for rate limiting, REQUIRED for paid products) —
# audit remediation #9 makes the API rate limits persistent and global across
# serverless instances instead of per-instance best-effort. Create a REST
# database at https://console.upstash.com and add both values here and in
# Vercel → Settings → Environment Variables.
# Without them the limiter automatically runs in-memory, AND the paid-product
# routes fail closed: /api/opportunity-brief/inquiry answers 503 rather than
# storing a buyer enquiry in memory that a redeploy would wipe.
# Each API request then costs one Redis pipeline round trip (~1ms, free tier
# covers roughly 10k commands/day).
# ALSO REQUIRED (fail-closed) by /api/opportunity-brief/inquiry — the
# commercial enquiry store uses the ob:enquiry:* namespace and refuses
# submissions (503) when these variables are absent, so buyer enquiries can
# never silently evaporate in serverless memory.
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."

# Sentry (optional) — error tracking + performance for the site. Without
# NEXT_PUBLIC_SENTRY_DSN the SDK initialises but drops every event, so an
# empty value is safe. Browser events are proxied through /monitoring on our
# own origin (tunnelRoute), so the CSP needs no *.ingest.sentry.io entry.
# Create the project under https://sentry.io (org: datacentre254), then set:
# NEXT_PUBLIC_SENTRY_DSN="https://<public-key>@o<org-id>.ingest.us.sentry.io/<project-id>"
# Build-time source map upload (read by next build on Vercel/CI, never runtime):
# SENTRY_AUTH_TOKEN="sntrys_..."  # scopes: org:read, project:read, project:write, event:write
# SENTRY_ORG="datacentre254"
# SENTRY_PROJECT="data-centers-254"
# SENTRY_ENVIRONMENT="production"  # optional; falls back to VERCEL_ENV
# Session Replay (browser): samples 10% of sessions, 100% of sessions with a
# client error. Needs "worker-src 'self' blob:" in the CSP for the replay
# compression worker (already added in next.config.ts). Vercel sets
# NEXT_PUBLIC_SENTRY_ENVIRONMENT per target — it must be NEXT_PUBLIC_* because
# only those vars are inlined into the client bundle; the client cannot see
# SENTRY_ENVIRONMENT or VERCEL_ENV.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"

# NVIDIA NIM (optional) — Jibu's dormant fail-over LLM slot #2. Activates
# automatically the moment this key exists in Vercel env; Groq stays primary.
# Get a free key at https://build.nvidia.com → "Get API Key" (nvapi-…).
# NOTE (verified 2026-09-05 with a real account key): the /models catalog
# lists 81 models but only a subset answers per account. Verified working:
#   openai/gpt-oss-20b, minimaxai/minimax-m3,
#   nvidia/nemotron-3-super-120b-a12b, nvidia/nemotron-3.5-lightning-30b-a3b
# deepseek-* deployments currently hang via the API; several other catalog
# ids 404 ("Not found for account"). The chain self-heals either way.
# NVIDIA_API_KEY="nvapi-..."
# NVIDIA_MODEL="openai/gpt-oss-20b"   # optional pin of the first candidate

# HuggingFace Inference Providers (optional) — Jibu's dormant fail-over slot
# #3. OpenAI-compatible router over many providers; monthly inference credits
# (free tier $0.10/mo, PRO $2/mo). Create a token at
# https://huggingface.co/settings/tokens (hf_…, "Make calls to Inference Providers").
# HF_TOKEN="hf_..."
# HF_MODEL="openai/gpt-oss-120b"      # optional pin of the first candidate

# ── Jibu LLM wiring: legacy alias variables (all optional) ──────────────────
# src/lib/chatbot/llm.ts reads these as fallback aliases. You normally do not
# need to set any of them; GROQ_API_KEY / NVIDIA_API_KEY / HF_TOKEN above are
# the primary way to configure providers.
# CHAT_LLM_API_KEY=""      # alias tried before GROQ_API_KEY (legacy name)
# CHAT_LLM_BASE_URL=""     # override the Groq base URL entirely (custom gateway)
# CHAT_LLM_MODEL=""        # alias of GROQ_MODEL
# HUGGINGFACE_MODEL=""     # alias of HF_MODEL
# CHAT_TTS_MODEL=""        # override Jibu's voice model id (Groq playai-tts)

# Resend audience alias (optional) — src/lib/resend-audience.ts reads
# RESEND_SEGMENT_ID first, then RESEND_AUDIENCE_ID. One is enough; both exist
# because Resend renamed Audiences to Segments.
# RESEND_AUDIENCE_ID=""

# ── Editor-side research tooling (scripts/, never read by the site) ─────────
# Context Dev capture/search client (scripts/contextdev_*.mjs).
# CONTEXT_DEV_API_KEY=""
# Firecrawl research client (scripts/firecrawl_*.mjs).
# FIRECRAWL_API_KEY=""
