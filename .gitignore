.env*
!.env.example

# Build artifacts
.next/
out/
dist/
build/
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel

# Logs
*.log
dev.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local data at the repo root (never commit subscriber or runtime data).
